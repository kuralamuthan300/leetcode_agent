# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/

# Runtime / generated — keep dir, ignore contents (except .gitkeep/examples)
workspace/jobs/*
!workspace/jobs/.gitkeep
workspace/problems/*
!workspace/problems/.gitkeep
!workspace/problems/examples/
audit.jsonl
registry.jsonl

# Local env
.env

# MLflow local store (tracking server data)
mlflow.db
mlruns/
mlartifacts/

# OpenCode local plugin deps (auto-commit runs from source)
.opencode/plugins/*/node_modules/
.opencode/plugins/*/package-lock.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# Agent run artifacts (keep dir)
output/*.json
!output/.gitkeep

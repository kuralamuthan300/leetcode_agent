*.pyc
*.pyo
.venv/
.pytest_cache/

# Runtime / generated — keep dir, ignore contents (except .gitkeep/examples)
workspace/jobs/*
!workspace/jobs/.gitkeep
workspace/problems/*
!workspace/problems/.gitkeep
!workspace/problems/examples/

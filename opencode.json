{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git add*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git merge-base*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git for-each-ref*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git merge --squash opencode/*",
      "effect": "allow"
    }
  ]
}

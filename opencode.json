{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git add*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git merge-base*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git for-each-ref*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git merge --squash opencode/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git worktree*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git checkout*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git merge*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git fetch*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-list*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".venv/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".pytest_cache/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "uv.lock",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "uv.lock",
      "effect": "deny"
    },
    {
      "action": "glob",
      "resource": ".venv/*",
      "effect": "deny"
    }
  ]
}
